# Copy to .env for local development: cp .env.example .env
# Placeholder values only. Real values never go in git; on AWS they come from SSM Parameter Store.
# New settings are added here in the same change that starts reading them.

LOG_LEVEL=INFO

# Host port for the API and web UI under docker compose (bound to 127.0.0.1 only).
API_PORT=8000

# Postgres, shared by the postgres container and the app. POSTGRES_HOST is the Compose service name.
# The password is for local use only; on EC2 all four come from Parameter Store (password as SecureString).
POSTGRES_HOST=postgres
POSTGRES_DB=sentinelstream
POSTGRES_USER=sentinelstream
POSTGRES_PASSWORD=local-dev-only

# Orchestration (optional; the defaults below apply when unset, on EC2 too).
# How often the scheduler enqueues due tasks and reconciles runs, and how often an idle worker polls.
SCHEDULER_POLL_SECONDS=30
WORKER_POLL_SECONDS=5
# A pending run no worker claims within this long is failed.
TASK_RUN_PENDING_TIMEOUT_SECONDS=3600
# A running run whose worker has gone is failed once it is at least this old.
TASK_RUN_RUNNING_GRACE_SECONDS=60

# SEC EDGAR (ingest_sec_filings). SEC requires an application name and a contact e-mail; the job
# fails with a clear error while this is empty. On EC2: Parameter Store, String.
SEC_USER_AGENT=

# Massive daily bars (ingest_prices). The job fails with a clear error while the key is empty.
# On EC2: Parameter Store, SecureString.
MASSIVE_API_KEY=
# Optional: requests per minute (5 is the free plan's limit) and the first run's history in days.
MASSIVE_RATE_LIMIT_PER_MINUTE=5
PRICE_LOOKBACK_DAYS=30

# Slack incoming webhook for high alerts (ingest_sec_filings). While it is empty, a poll that has a
# high alert to send ends `partial` with a clear error, and the alert stays queued. Anyone holding the
# URL can post to the channel: treat it as a secret. On EC2: Parameter Store, SecureString.
SLACK_WEBHOOK_URL=

# Web sign-in (api). Without AUTH_SESSION_SECRET, login answers 503 with a clear error.
# AUTH_SESSION_SECRET signs session cookies: at least 32 random characters (e.g. `openssl rand -base64 48`).
# AUTH_ADMIN_PASSWORD (at least 12 characters) is used only by the first login of the `admin` user,
# which stores its hash; changing it later has no effect. On EC2 both are Parameter Store SecureStrings.
AUTH_SESSION_SECRET=
AUTH_ADMIN_PASSWORD=
# Set to true once the UI is served over HTTPS. Over SSM port forwarding it is plain http://localhost.
AUTH_COOKIE_SECURE=false
