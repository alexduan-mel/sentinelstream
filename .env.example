# Copy to .env for local development: cp .env.example .env
# Placeholder values only. Real values never go in git; on AWS they come from SSM Parameter Store.
# New settings are added here in the same change that starts reading them.

LOG_LEVEL=INFO

# Host port for the API and web UI under docker compose (bound to 127.0.0.1 only).
API_PORT=8000

# Postgres, shared by the postgres container and the app. POSTGRES_HOST is the Compose service name.
# The password is for local use only; on EC2 all four come from Parameter Store (password as SecureString).
POSTGRES_HOST=postgres
POSTGRES_DB=sentinelstream
POSTGRES_USER=sentinelstream
POSTGRES_PASSWORD=local-dev-only

# Orchestration (optional; the defaults below apply when unset, on EC2 too).
# How often the scheduler enqueues due tasks and reconciles runs, and how often an idle worker polls.
SCHEDULER_POLL_SECONDS=30
WORKER_POLL_SECONDS=5
# A pending run no worker claims within this long is failed.
TASK_RUN_PENDING_TIMEOUT_SECONDS=3600
# A running run whose worker has gone is failed once it is at least this old.
TASK_RUN_RUNNING_GRACE_SECONDS=60
